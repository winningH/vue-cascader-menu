{
  "name": "vue-cascader-menu",
  "version": "1.2.0",
  "description": "Vue 2 多级级联下拉菜单组件，支持异步加载与多实例互斥",
  "type": "module",
  "main": "./dist/vue-cascader-menu.umd.cjs",
  "module": "./dist/vue-cascader-menu.js",
  "exports": {
    ".": {
      "import": "./dist/vue-cascader-menu.js",
      "require": "./dist/vue-cascader-menu.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "vue2",
    "dropdown",
    "cascader",
    "menu"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^2.6.14"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.1",
    "@vue/test-utils": "^1.3.6",
    "happy-dom": "^20.12.0",
    "jsdom": "^30.0.1",
    "vite": "^5.4.0",
    "vitest": "^4.1.11",
    "vue": "2.7.10",
    "vue-template-compiler": "2.7.10"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test",
    "postversion": "git push && git push --tags",
    "preversion": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winningH/vue-cascader-menu.git"
  },
  "homepage": "https://lighting-two.vercel.app/drop-menu",
  "bugs": {
    "url": "https://github.com/winningH/vue-cascader-menu/issues"
  }
}
